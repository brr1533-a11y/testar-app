# Gestão Rural v22 — exemplo de variáveis
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://SEU-SITE.onrender.com

# Banco compartilhado (obrigatório em produção)
DATABASE_URL=postgresql://usuario:senha@host/banco
# true passa a conferir o certificado do PostgreSQL (use se o provedor tiver certificado válido)
DATABASE_SSL_STRICT=false

# Grupo inicial
SEED_GROUP_SLUG=grupo-fagundes-miari
SEED_GROUP_CODE=1001
SEED_GROUP_NAME=Grupo Fagundes Miari
SEED_CEO_NAME=Jacques Miari
SEED_CEO_USER=jacquesmiari
SEED_CEO_PASSWORD=COLOQUE_UMA_SENHA_FORTE_DE_8_OU_MAIS
SEED_CEO_EMAIL=voce@seudominio.com.br
SESSION_DAYS=30

# Super Admin /platform
PLATFORM_ADMIN_EMAIL=voce@seudominio.com.br
PLATFORM_ADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE_E_EXCLUSIVA
PLATFORM_SESSION_HOURS=12
# Recomendado depois de configurar Resend:
PLATFORM_REQUIRE_2FA=false

# Legado: chave antiga. Não é usada no /platform em produção, salvo liberação explícita.
PLATFORM_SETUP_KEY=
ALLOW_LEGACY_PLATFORM_KEY=false

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-COLOQUE_SEU_ACCESS_TOKEN
MERCADOPAGO_PLAN_ID=
# Assinatura secreta dos avisos (Suas integrações > Webhooks > Configurar notificações).
# Com ela, avisos falsos são recusados.
MERCADOPAGO_WEBHOOK_SECRET=

# Compra simulada
# Em produção, TEST_PURCHASE_MODE=true é bloqueado por segurança.
TEST_PURCHASE_MODE=false
# Só para teste controlado num serviço separado; exige também TEST_MODE_UNTIL (no máximo 7 dias à frente).
ALLOW_TEST_MODE_IN_PRODUCTION=false
TEST_MODE_UNTIL=

# Monitor de preços das cotações com link (horas entre conferências; 0 desliga)
PRICE_WATCH_HOURS=6

# Mercado: estado da praça do boi gordo (sigla, ex.: MG, SP, GO, MS)
MARKET_UF=MG

# Teste grátis (dias, de 7 a 14)
TRIAL_DAYS=14

# Recuperação de senha / 2FA por e-mail (Resend)
RESEND_API_KEY=re_xxxxxxxxx
PASSWORD_RESET_FROM=Gestão Rural <acesso@seudominio.com.br>
PASSWORD_RESET_MINUTES=10

# Rede: quantos proxies ficam na frente do app (Render: 1). Fora de produção o servidor só atende este computador;
# HOST=0.0.0.0 libera para a rede local.
TRUST_PROXY=1
HOST=


# Preços por atividade: valores null em planos-atividades.json deixam a cobrança bloqueada.
# ACTIVITY_PRICES_JSON pode substituir o arquivo JSON quando os valores forem definidos.

# Etapas 3–8: serviços externos permanecem desligados.
# Emissão/busca SEFAZ, previsão e WhatsApp exigem um adaptador homologado em integracoes-etapas.js.
# Este seletor só será usado pelo adaptador fiscal; não ativa um emissor.
FISCAL_ENVIRONMENT=homologation

# Push: ligado por padrão. Sem chaves aqui, o servidor gera um par VAPID uma única vez e guarda na configuração
# do banco (a chave privada nunca vai ao navegador). PUSH_ENABLED=false desliga.
# Para usar chaves próprias, preencha as duas. VAPID_SUBJECT: mailto: ou https:// (padrão: PUBLIC_BASE_URL).
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Previsão do tempo pelo Open-Meteo (gratuito, sem chave). off desliga.
WEATHER_PROVIDER=open-meteo

# Ajuda em cada tela: WhatsApp do suporte (país + DDD + número, só dígitos) e endereço base dos vídeos
# (o painel abre <endereço>/<página>). Vazio esconde os botões.
SUPPORT_WHATSAPP=
SUPPORT_VIDEO_URL=

# Backup automático de todos os Grupos, com teste de restauração logo depois de gravar.
# BACKUP_DIR precisa ser um disco que não se apaga a cada publicação (no Render: disco persistente).
# BACKUP_KEY cifra os arquivos (AES-256-GCM); guarde-a fora do servidor, sem ela o backup não abre.
BACKUP_HOURS=24
BACKUP_KEEP=14
BACKUP_DIR=
BACKUP_KEY=

# A consulta agregada exige consentimento e três fazendas de três grupos. Entram compras verificadas e notas
# importadas por XML com chave de acesso válida (uma fazenda = um voto).
# A versão pública fica desligada até a revisão de privacidade e liberação comercial.
COLLECTIVE_PUBLIC_ENABLED=false
# IA consultiva — desligada por padrão. Configure os segredos SOMENTE no servidor.
# Ative apenas depois de escolher o modelo e conferir cobrança/créditos no provedor.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Limite de tentativas por dia UTC, global neste processo (não é teto em reais).
# Reinicia com o servidor. Não use várias instâncias como controle de orçamento.
AI_DAILY_REQUEST_LIMIT=10
# Opcional: IDs internos dos grupos que podem usar IA, separados por vírgula.
# Vazio permite a todos os CEOs quando AI_ENABLED=true.
AI_ALLOWED_GROUP_IDS=

